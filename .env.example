VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_CESIUM_ION_TOKEN=your-cesium-ion-token-here
VITE_CARTO_API_KEY=your-carto-api-key-here
VITE_BACKEND_API_URL=http://localhost:5000
# ---------------------------------------------------------------------------
# TiTiler caching-stack base (serves titiler/float32/terrarium under one prefix)
#
# WHERE TO SET IT:
#  - TITILER_API_BASE (preferred, runtime, no rebuild): set in the environment of
#    the process that runs serve_web.py (the deployed static server). It is read
#    at request time and injected into window.TITILER_API_BASE, which WINS over
#    everything else. Use for per-environment deployment on infrastructure.
#  - VITE_TITILER_API_BASE (build-time fallback): set in .env or the build
#    environment and baked into the bundle. Use when the app is served by a
#    static host that cannot run serve_web.py (e.g. GitHub Pages).
#  - VITE_TITILER_URL (legacy build-time fallback): a full TiTiler URL, kept for
#    backwards compat and normalized to a base (a trailing /titiler segment is
#    stripped). Prefer the vars above.
#
# Same-origin values (e.g. /titiler/api/v1) are COEP-safe via the Vite proxy /
# reverse proxy. Absolute HTTPS URLs also work; absolute http:// will be blocked
# by COEP in the browser. When unset, the bundled local default is
# '/titiler/api/v1' (localhost:8001 via the dev proxy).
#
# TITILER_API_BASE=/titiler/api/v1
# VITE_TITILER_API_BASE=/titiler/api/v1
# VITE_TITILER_URL=https://titiler.example/api/v1/titiler
# ---------------------------------------------------------------------------
# TiTiler instance serving the DEMO COG tiles (local docker compose by default).
# Leave unset for local dev: the built-in endpoint already uses the same-origin
# Vite proxy path (/titiler/api/v1/titiler) that is COEP-safe.
#
# VITE_TITILER_URL is the LEGACY build-time override and is treated as a stack
# base: the app appends '/titiler' to it. So a bare TiTiler root is correct here
# (e.g. https://titiler.example/api/v1), NOT a URL that already ends in
# '/titiler'. Absolute https:// works; http:// is blocked by COEP in the browser.
# VITE_TITILER_URL=https://your-deployed-titiler.example/api/v1
