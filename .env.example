VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_CESIUM_ION_TOKEN=your-cesium-ion-token-here
VITE_CARTO_API_KEY=your-carto-api-key-here
VITE_BACKEND_API_URL=http://localhost:5000
# TiTiler instance serving the DEMO COG tiles (local docker compose by default).
# Leave unset for local dev: the built-in endpoints already use same-origin Vite
# proxy paths (/titiler-plain, /titiler/api/v1/titiler) that are COEP-safe.
# Setting this to http://localhost:8000 adds a direct CROSS-ORIGIN 'custom'
# endpoint that COEP blocks (ERR_BLOCKED_BY_RESPONSE), defeating the proxy.
# Only set it to a deployed HTTPS TiTiler instance.
# VITE_TITILER_URL=https://your-deployed-titiler.example
